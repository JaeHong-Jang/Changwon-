# ===== API 키 설정 =====
# 이 파일을 .env로 복사한 뒤 실제 키를 입력하세요
# .env 파일은 .gitignore에 의해 git에 올라가지 않습니다

# 공공데이터포털 API 키
DATA_GO_KR_API_KEY=your_api_key_here

# 기타 API 키 (필요시)
# KAKAO_REST_API_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# V-World 인증키 (vworld.kr 회원가입 → 오픈API)
VWORLD_API_KEY=
# 재난안전데이터공유플랫폼 (safetydata.go.kr)
SAFETYDATA_API_KEY=
